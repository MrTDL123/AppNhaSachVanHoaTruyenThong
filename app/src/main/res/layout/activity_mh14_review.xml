<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_screen"
    android:focusableInTouchMode="true"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@drawable/bg_header_gradient"
        app:navigationContentDescription="@string/hieu_review_back"
        app:navigationIcon="?attr/homeAsUpIndicator"
        app:navigationIconTint="@color/white"
        app:title="@string/hieu_review_title"
        app:titleTextColor="@color/white" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <ProgressBar
                android:id="@+id/orderProgress"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_gravity="center_horizontal"
                android:visibility="gone" />

            <TextView
                android:id="@+id/orderStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:accessibilityLiveRegion="polite"
                android:textColor="@color/primary_red"
                android:visibility="gone" />

            <Button
                android:id="@+id/btnRetryOrder"
                style="@style/Widget.App.Button.Outlined"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/hieu_review_retry"
                android:visibility="gone" />

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/reviewForm"
                style="@style/Widget.App.CardView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone"
                tools:visibility="visible">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/hieu_review_book"
                        android:textColor="@color/text_sub" />

                    <TextView
                        android:id="@+id/tvProductTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:textColor="@color/text_main"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        tools:text="Truyện Kiều" />

                    <Spinner
                        android:id="@+id/bookPicker"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:contentDescription="@string/hieu_review_select"
                        android:saveEnabled="false"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/tvRatingLabel"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        android:labelFor="@+id/ratingBar"
                        android:text="@string/hieu_review_rating"
                        android:textColor="@color/text_main"
                        android:textSize="16sp" />

                    <RatingBar
                        android:id="@id/ratingBar" android:saveEnabled="false"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:numStars="5"
                        android:progressTint="@color/star_gold"
                        android:stepSize="1"
                        tools:rating="4" />


                    <TextView android:id="@+id/ratingMeaning" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/primary_red"
                        android:text="@string/hieu_extra_rating_0" android:accessibilityLiveRegion="polite" />
                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilComment"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:hint="@string/hieu_review_comment">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etComment" android:saveEnabled="false"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="top"
                            android:inputType="textMultiLine|textCapSentences"
                            android:minLines="4" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <TextView
                        android:id="@+id/submitError"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:accessibilityLiveRegion="polite"
                        android:textColor="@color/primary_red"
                        android:visibility="gone" />

                    <ProgressBar
                        android:id="@+id/submitProgress"
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:layout_gravity="center_horizontal"
                        android:layout_marginTop="12dp"
                        android:visibility="gone" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnSubmitReview"
                        style="@style/Widget.App.Button.Primary"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:minHeight="48dp"
                        android:text="@string/hieu_review_submit" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
