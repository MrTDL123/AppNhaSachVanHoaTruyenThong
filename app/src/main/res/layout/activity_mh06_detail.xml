<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto" xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_screen">

    <!-- Header Đỏ Fahasa -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/toolbar"
        android:layout_width="0dp"
        android:layout_height="52dp"
        android:background="@drawable/bg_header_gradient"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/btnBack" android:contentDescription="@string/hieu_detail_back" android:focusable="true" android:background="?attr/selectableItemBackgroundBorderless"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@android:drawable/ic_menu_revert"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="@color/white" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:text="@string/hieu_detail_title"
            android:textColor="@color/white"
            android:textSize="18sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toEndOf="@+id/btnBack"
            app:layout_constraintTop_toTopOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <ScrollView
        android:id="@+id/scrollView" android:visibility="gone" tools:visibility="visible"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@+id/layoutBottomAction"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/toolbar">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="24dp">

            <!-- Card Bìa Sách & Giá -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.App.CardView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <ImageView
                        android:id="@+id/ivBookCover" android:contentDescription="@string/hieu_extra_zoom"
                        android:layout_width="180dp"
                        android:layout_height="250dp"
                        android:layout_gravity="center_horizontal"
                        android:scaleType="fitCenter" tools:src="@tools:sample/backgrounds/scenic" />
                    <LinearLayout android:id="@+id/galleryControls" android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:gravity="center" android:visibility="gone" tools:visibility="visible">
                        <Button android:id="@+id/btnPreviousImage" android:layout_width="wrap_content" android:layout_height="wrap_content" style="@style/Widget.App.Button.Outlined" android:text="@string/hieu_detail_previous_image" />
                        <TextView android:id="@+id/imagePosition" android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:paddingHorizontal="10dp" tools:text="1/3" />
                        <Button android:id="@+id/btnNextImage" android:layout_width="wrap_content" android:layout_height="wrap_content" style="@style/Widget.App.Button.Outlined" android:text="@string/hieu_detail_next_image" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvTitle" tools:text="Truyện Kiều"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:textColor="@color/text_main"
                        android:textSize="20sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvAuthor" tools:text="Tác giả · Nguyễn Du"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:textColor="@color/text_sub"
                        android:textSize="14sp" />

                    <TextView android:id="@+id/stockStatus"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:layout_marginTop="6dp" android:textColor="@color/text_sub"
                        tools:text="Còn 12 cuốn" />


                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_weight="1" android:text="@string/hieu_extra_quantity" android:textColor="@color/text_main" />
                        <Button android:id="@+id/quantityLess" android:layout_width="48dp" android:layout_height="48dp"
                            android:text="@string/hieu_extra_minus" android:contentDescription="@string/hieu_extra_less" />
                        <TextView android:id="@+id/quantityValue" android:layout_width="40dp" android:layout_height="wrap_content"
                            android:gravity="center" tools:text="1" android:textColor="@color/text_main" />
                        <Button android:id="@+id/quantityMore" android:layout_width="48dp" android:layout_height="48dp"
                            android:text="@string/hieu_extra_plus" android:contentDescription="@string/hieu_extra_more" />
                    </LinearLayout>
                    <!-- Price Row Fahasa Style -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tvFinalPrice" tools:text="85.000 đ"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="@color/price_red"
                            android:textSize="24sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvOriginalPrice" tools:text="100.000 đ"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:textColor="@color/price_original"
                            android:textSize="15sp" />

                        <TextView
                            android:id="@+id/tvDiscount" tools:text="-15%" android:paddingHorizontal="5dp"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:background="@drawable/bg_badge_discount"
                            android:textColor="@color/white"
                            android:textSize="12sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/bg_rating_pill"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <RatingBar
                            android:id="@+id/ratingBar"
                            style="?android:attr/ratingBarStyleSmall"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:isIndicator="true"
                            android:numStars="5"
                            android:progressTint="@color/star_gold"
                            android:stepSize="0.1" />

                        <TextView
                            android:id="@+id/tvRating" tools:text="4,8/5 (12 đánh giá)"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:textColor="#F57C00"
                            android:textSize="13sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Card Mô Tả -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.App.CardView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="12dp"
                android:layout_marginTop="6dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/hieu_detail_description"
                        android:textColor="@color/primary_red"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvDescription" android:maxLines="5" android:ellipsize="end" tools:text="Một tác phẩm kinh điển của văn học Việt Nam."
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:lineSpacingExtra="5dp"
                        android:textColor="@color/text_main"
                        android:textSize="14sp" />
                    <Button android:id="@+id/toggleDescription" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" style="@style/Widget.App.Button.Outlined"
                        android:text="@string/hieu_extra_read_more" android:visibility="gone" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView android:id="@+id/specsCard"
                style="@style/Widget.App.CardView" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginHorizontal="12dp" android:layout_marginTop="12dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/hieu_detail_specs" android:textColor="@color/primary_red" android:textStyle="bold" />
                    <TextView android:id="@+id/tvSpecs" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/text_main" android:layout_marginTop="8dp" android:lineSpacingExtra="4dp" tools:text="Nhà xuất bản · Văn học" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.App.CardView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="12dp"
                android:layout_marginTop="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/hieu_detail_reviews"
                        android:textColor="@color/primary_red"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rvReviews"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:nestedScrollingEnabled="false" app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                        tools:itemCount="1" tools:listitem="@layout/item_hieu_detail_review" />
                    <TextView android:id="@+id/reviewStatus" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/text_main" android:visibility="gone" android:accessibilityLiveRegion="polite" />
                    <ProgressBar android:id="@+id/reviewProgress" android:layout_width="32dp" android:layout_height="32dp"
                        android:layout_gravity="center" android:visibility="gone" />
                    <Button android:id="@+id/btnMoreReviews" android:layout_width="wrap_content" android:layout_height="wrap_content" style="@style/Widget.App.Button.Outlined" android:text="@string/hieu_detail_more" android:visibility="gone" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </ScrollView>

    <!-- Bottom Bar (Thêm vào giỏ hàng) -->
    <LinearLayout
        android:id="@+id/layoutBottomAction"
        android:layout_width="0dp"
        android:layout_height="wrap_content" android:minHeight="64dp"
        android:background="@color/white"
        android:elevation="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <Button
            android:id="@+id/btnCart"
            style="@style/Widget.App.Button.Outlined"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:text="@string/hieu_detail_cart" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAddToCart" android:layout_weight="1" android:layout_marginStart="8dp"
            style="@style/Widget.App.Button.Primary"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:text="@string/hieu_detail_add"
            android:textSize="15sp"
            app:icon="@android:drawable/ic_input_add" />
    </LinearLayout>

    <ProgressBar
        android:id="@+id/progressBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:indeterminateTint="@color/primary_red"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <LinearLayout android:id="@+id/detailStatus" android:layout_width="0dp" android:layout_height="wrap_content" android:orientation="vertical"
        android:gravity="center" android:padding="16dp" android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/toolbar" app:layout_constraintBottom_toTopOf="@id/layoutBottomAction"
        app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent">
        <TextView android:id="@+id/statusMessage" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/text_main" android:gravity="center" android:accessibilityLiveRegion="polite" />
        <Button android:id="@+id/btnRetry" android:layout_width="wrap_content" android:layout_height="wrap_content" style="@style/Widget.App.Button.Outlined" android:text="@string/hieu_detail_retry" />
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
